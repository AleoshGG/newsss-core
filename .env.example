# Entorno de ejecución
ENVIRONMENT=development
DEBUG=True
APP_NAME="Newsss Core"

# Base de datos (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=newsss_db

# URLs de conexión para SQLAlchemy
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_URL_SYNC=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
GEMINI_MODEL="gemini-3.8-flash"  # Optional, default is gemini-3.8-flash

# Security
APP_API_KEY=your_super_secret_api_key_here
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=100
